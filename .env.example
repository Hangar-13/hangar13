# Copy to `.env.local` for normal local dev, or use as a checklist when creating `.env.live.local`.
# See README.md → “Which backend am I talking to?”.

# --- App URLs (SAML / redirects / absolute links) ---
# For local UI hitting production APIs, use http://localhost:3000 so cookies and SAML flows match your browser.
APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Resend) ---
# Used to send the automated welcome email after a new user confirms their address.
# If unset, signup/confirmation still work; the welcome email is simply skipped.
# Get a key at https://resend.com → API Keys. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM="Hangar 13 <hello@yourdomain.com>"

# Optional: Bearer token required for cron routes when CRON_SECRET is set (recommended in production).
# Vercel cron still works without it via `x-vercel-cron: 1`; use secret for manual / third-party pings.
CRON_SECRET=

# --- TalentLMS API ---
TALENTLMS_SUBDOMAIN=
TALENTLMS_API_KEY=
# Periodic reconcile cron — off unless true. See docs/talent-lms-reconcile-cron.md + vercel.json crons.
# TALENTLMS_RECONCILE_CRON_ENABLED=true

# --- TalentLMS SAML (Hangar IdP → Talent SP); PEM values often use literal \n for newlines ---
TALENTLMS_IDP_SIGNING_PRIVATE_KEY=
TALENTLMS_IDP_SIGNING_CERTIFICATE=
# TALENTLMS_SP_ENTITY_ID=
# TALENTLMS_SP_ACS_URL=
# TALENTLMS_SP_SLO_URL=
# TALENTLMS_IDP_ENTITY_ID=
# TALENTLMS_SAML_USERNAME_MODE=email
#
# SSO error `idp_email_already_exists`: Talent sees your email but the SAML Username Login
# does not match that user’s Talent "Login". Align Talent Login with this mode OR fix SAML
# attribute mapping vs TALENTLMS_SAML_ATTR_* — see docs/talent-lms-saml-troubleshooting.md.
# Optional attribute OIDs (defaults in lib/talentlms/saml-config.ts — must match Talent UI):
# TALENTLMS_SAML_ATTR_USERNAME=
# TALENTLMS_SAML_ATTR_EMAIL=
#
# Temporary diagnostics: logs email + SAML username to server stdout on each IdP hit (remove after fixing SSO).
# TALENTLMS_SAML_DIAGNOSTIC_LOGGING=true
